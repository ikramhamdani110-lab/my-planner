# ── Dependencies ─────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Build output ─────────────────────────────────────────────
dist/
dist-ssr/
*.local

# ── Logs and caches ──────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.vite/
.cache/

# ── Environment / secrets (never commit credentials) ─────────
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# ── Local databases and personal data ────────────────────────
# A real planner database contains your private tasks and notes.
# The committed src/data/seed.json is a clean starting dataset only.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
my-planner*.json
*-backup*.json

# ── Windows installers and desktop-app artifacts ─────────────
release/
win-unpacked/
dist-electron/
*.exe
*.msi
*.nsis
*.blockmap
*.asar

# ── Editor / OS noise ────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ── Test and verification scratch output ─────────────────────
_verify/
coverage/
*.png.tmp
